---
import LegalLayout from "@layouts/LegalLayout.astro";
import cookiesContent from "@/content/legal/cookies-pl.json";
import { legalBodyToHtml } from "@utils/legal-body-to-html";

const injectData = (text: string) => text;

const html = legalBodyToHtml(injectData(cookiesContent.body));
const title = cookiesContent.title;
const description = injectData(cookiesContent.description || "");
---

<LegalLayout title={title} description={description} lastUpdated={cookiesContent.lastUpdated} locale="pl">
  <div set:html={html} />
</LegalLayout>
