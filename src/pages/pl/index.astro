---
import Layout from '@layouts/Layout.astro';
import PageBuilder from '@components/PageBuilder.astro';
import { getNovaCopy, type NovaLocale } from '@utils/nova-i18n';

const locale: NovaLocale = 'pl';
const localized = getNovaCopy(locale);
---

<Layout
  title={localized.page.title}
  description={localized.page.description}
  lang={locale}
  locale={locale}
  fullBleedTop={true}
>
  <PageBuilder locale={locale} />
</Layout>
