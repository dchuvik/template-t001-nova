---
import LegalLayout from "@layouts/LegalLayout.astro";
import privacyContent from "@/content/legal/privacy-policy-pl.json";
import { legalBodyToHtml } from "@utils/legal-body-to-html";

const injectData = (text: string) => text;

const html = legalBodyToHtml(injectData(privacyContent.body));
const title = privacyContent.title;
const description = injectData(privacyContent.description || "");
---

<LegalLayout title={title} description={description} lastUpdated={privacyContent.lastUpdated} locale="pl">
  <div set:html={html} />
</LegalLayout>
