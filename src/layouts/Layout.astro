---
import '@styles/global.css';
import '@styles/.generated/phosphor.css';
import { ClientRouter } from 'astro:transitions';
import seo from '@data/global/seo.json';
import Schema from '@components/ui/atoms/Schema.astro';
import FloatingBar from '@components/ui/molecules/FloatingBar.astro';
import MobileDrawer from '@components/ui/molecules/Navbar/shared/MobileDrawer.astro';
import Navbar from '@components/ui/molecules/Navbar.astro';
import NovaFooterBlock from '@components/registry/shell/NovaFooterBlock.astro';
import AppointmentDialog from '@components/ui/molecules/AppointmentDialog.astro';
import { SITE_LOCALE } from '../../site.config.mjs';
import type { NovaLocale } from '@utils/nova-i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  lang?: string;
  locale?: NovaLocale;
  fullBleedTop?: boolean;
}

const isPreview = import.meta.env.CONTEXT === 'deploy-preview'
  || import.meta.env.CONTEXT === 'branch-deploy'
  || import.meta.env.STAGING === 'true'
  || ['localhost', '127.0.0.1'].includes(Astro.site?.hostname ?? 'localhost');
const {
  title = seo.defaultTitle,
  description = seo.defaultDescription,
  ogImage = seo.defaultOgImage,
  noIndex = isPreview || !seo.index,
  lang = SITE_LOCALE,
  locale = SITE_LOCALE,
  fullBleedTop = false,
} = Astro.props;
const publicSiteUrl = process.env.PUBLIC_SITE_URL || Astro.site!;
const configuredSitePath = new URL(publicSiteUrl).pathname;
const basePath = process.env.PUBLIC_BASE_PATH || (configuredSitePath !== '/' ? configuredSitePath : import.meta.env.BASE_URL);
const normalizedBasePath = basePath === '/' ? '' : `/${basePath.replace(/^\/+|\/+$/g, '')}`;
const assetBasePath = process.env.PUBLIC_BASE_PATH || (import.meta.env.DEV ? import.meta.env.BASE_URL : basePath);
const normalizedAssetBasePath = assetBasePath === '/' ? '' : `/${assetBasePath.replace(/^\/+|\/+$/g, '')}`;
const publicAsset = (assetPath: string) => `${normalizedAssetBasePath}/${assetPath.replace(/^\/+/, '')}`;
const siteOrigin = new URL(publicSiteUrl).origin;
const canonicalURL = new URL(`${normalizedBasePath}${Astro.url.pathname}`, siteOrigin).href;
const ogImageAbsolute = new URL(publicAsset(ogImage), siteOrigin).href;
const robotsContent = `${noIndex ? 'noindex' : 'index'}, ${seo.follow ? 'follow' : 'nofollow'}`;
const mainPaddingStyle = fullBleedTop ? 'padding-top: 0' : 'padding-top: calc(var(--site-header-height, 5.75rem) + var(--hero-below-header-gap, 0.75rem))';
---

<!DOCTYPE html>
<html lang={lang} data-theme="nova" data-lenis="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" as="font" type="font/woff2" href={publicAsset('/fonts/satoshi-400.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={publicAsset('/fonts/satoshi-500.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={publicAsset('/fonts/satoshi-700.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={publicAsset('/fonts/satoshi-900.woff2')} crossorigin />
    <link rel="icon" type="image/svg+xml" href={publicAsset('/favicon.svg')} />
    <link rel="apple-touch-icon" href={publicAsset('/apple-touch-icon.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={publicAsset('/favicon-32x32.png')} />
    <link rel="shortcut icon" href={publicAsset('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.setAttribute('data-motion-ready', '');
      setTimeout(function () {
        if (!window.__webscaleFadeMotion) document.documentElement.removeAttribute('data-motion-ready');
      }, 3000);
    </script>
    <ClientRouter />
    <Schema />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ws:; form-action 'self'; base-uri 'self';" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <link rel="canonical" href={canonicalURL} />
  </head>
  <body class="min-h-screen flex flex-col ui-bg-page font-sans text-brand-dark antialiased selection:bg-brand-primary/10 selection:text-brand-primary">
    <MobileDrawer locale={locale} />
    <div class="relative"><Navbar theme="light" locale={locale} /></div>
    <main class="flex-1 flex flex-col" style={mainPaddingStyle}><slot /></main>
    <NovaFooterBlock locale={locale} />
    <AppointmentDialog locale={locale} />
    <script is:inline data-astro-rerun src="/js/motion.js" defer></script>
    <script is:inline>
      document.addEventListener('astro:before-swap', function () { document.documentElement.style.scrollBehavior = 'auto'; });
      document.addEventListener('astro:page-load', function () { document.documentElement.style.scrollBehavior = ''; });
    </script>
    <script is:inline data-astro-rerun src="/js/navbar.js" defer></script>
    <script is:inline data-astro-rerun src="/js/accordion.js" defer></script>
    <script is:inline src="/js/lenis-lib.min.js" defer></script>
    <script is:inline src="/js/lenis.js" defer></script>
    <FloatingBar />
  </body>
</html>
