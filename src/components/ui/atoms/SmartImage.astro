---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src?: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  placeholder?: boolean;
}

const {
  src,
  alt = '',
  width = 800,
  height = 600,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
  sizes = `(max-width: ${width}px) 100vw, ${width}px`,
  placeholder = false,
} = Astro.props;
const showPlaceholder = placeholder || !src;

// Use only derivatives that exist. The browser chooses a width for its screen
// and pixel density, with AVIF preferred and WebP as the fallback.
const widths = [220, 480, 640, 800, 1080, 1280, 1600, 1920];
const derivativeBase = src?.startsWith('/assets/images/')
  ? src.replace(/\.[a-z0-9]+$/i, '')
  : undefined;
const variants = (format: string) => derivativeBase
  ? widths.flatMap((width) => {
      const url = `${derivativeBase}${width === 800 ? '' : `@${width}`}.${format}`;
      return fs.existsSync(path.join(process.cwd(), 'public', url.slice(1)))
        ? [{ url, width }]
        : [];
    })
  : [];
const webp = variants('webp');
const avif = variants('avif');
const srcset = (images: { url: string; width: number }[]) => images.length
  ? images.map(({ url, width }) => `${url} ${width}w`).join(', ')
  : undefined;
const imageSrc = webp.find(({ width }) => width === 800)?.url || src;
---

{showPlaceholder ? (
  <div class:list={['aspect-video flex items-center justify-center bg-brand-dark/5 rounded-xl', className]}>
    <svg class="w-10 h-10 text-brand-dark/20" fill="none" stroke="currentColor" viewBox="0 0 256 256" aria-hidden="true">
      <path d="M216 40H40a16 16 0 00-16 16v144a16 16 0 0016 16h176a16 16 0 0016-16V56a16 16 0 00-16-16zm0 160H40V56h176v144zm-24-88a16 16 0 11-16-16 16 16 0 0116 16zm-110.1 98.3l39.6-52.4a8 8 0 0112.6-.1l26.1 30.6 10.8-14.2a8 8 0 0112.4-.2l28.2 36.1H48a8 8 0 01-6.1-12.8z" stroke-width="12" />
    </svg>
  </div>
) : (
  <picture>
    {avif.length > 0 && <source srcset={srcset(avif)} sizes={sizes} type="image/avif" />}
    <img src={imageSrc} alt={alt} width={width} height={height}
      class={className} loading={loading} decoding={decoding} fetchpriority={fetchpriority}
      srcset={srcset(webp)} sizes={webp.length ? sizes : undefined} />
  </picture>
)}
