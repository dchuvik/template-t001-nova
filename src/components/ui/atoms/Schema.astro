---
import companyRaw from '@data/global/company.json';
import seo from '@data/global/seo.json';
import type { CompanyConfig } from '@/types/config';
import { SITE_URL } from '../../../../site.config.mjs';


// Why: JSON.stringify does not escape '<', which inside set:html
// could be interpreted as an HTML tag opening (XSS vector via
// JSON data). Escaping to \u003c neutralizes it, and JSON-LD parses identically.
const jsonLd = (data: object): string => JSON.stringify(data).replace(/</g, '\\u003c');

const company = companyRaw as CompanyConfig;
const siteBase = SITE_URL.replace(/\/$/, '');

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Locksmith',
	name: company.fullName || company.name,
	description: company.description || seo.defaultDescription,
	image: `${siteBase}/og-image.png`,
	'@id': siteBase,
	url: siteBase,
	telephone: /^[+\d\s().-]+$/.test(company.phone) && company.phone.replace(/\D/g, '').length >= 10 ? company.phone : undefined,
	email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(company.email) ? company.email : undefined,
	priceRange: company.priceRange || undefined,
	address: {
		'@type': 'PostalAddress',
		streetAddress: company.address && !company.address.includes('[') ? company.address : undefined,
		addressLocality: company.city,
		addressRegion: company.state,
		postalCode: company.zipCode && !company.zipCode.includes('[') ? company.zipCode : undefined,
		addressCountry: company.country,
	},
	geo: company.geo ? {
		'@type': 'GeoCoordinates',
		latitude: company.geo.lat,
		longitude: company.geo.lng,
	} : undefined,
	areaServed: company.areaServed?.map((name) => ({
		'@type': 'City',
		name: `${name}, NY`,
	})),
	hasOfferCatalog: company.services?.length ? {
		'@type': 'OfferCatalog',
		name: 'Automotive key services',
		itemListElement: company.services.map((name) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name },
		})),
	} : undefined,
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: seo.defaultTitle,
	url: siteBase,
};
---

<script type="application/ld+json" set:html={jsonLd(schema)} />
<script type="application/ld+json" set:html={jsonLd(websiteSchema)} />
