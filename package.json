{
  "name": "local-key",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node src/scripts/sync-phosphor-css.mjs",
    "dev": "astro dev",
    "postinstall": "node src/scripts/sync-phosphor-css.mjs",
    "prebuild": "node src/scripts/sync-phosphor-css.mjs",
    "build": "npm run assets:gen && npm run assets:img && astro build && node src/scripts/prune-images.mjs && node src/scripts/strip-html-comments.mjs && node src/scripts/prune-phosphor-css.mjs && node scripts/prefix-base-assets.mjs",
    "preview": "astro preview",
    "check:types": "astro check --minimumSeverity error",
    "check:imports": "tsx src/scripts/check-import-paths.ts",
    "check:seo": "tsx src/scripts/check-seo.ts",
    "check:seo:client": "tsx src/scripts/check-seo.ts --client",
    "check:links": "tsx src/scripts/check-links.ts",
    "check:images": "tsx src/scripts/check-images.ts",
    "design:sync": "tsx src/scripts/sync-design.ts",
    "assets:gen": "node src/scripts/generate-favicons.cjs",
    "assets:img": "tsx src/scripts/optimize-images.ts",
    "test": "vitest",
    "ai:check": "npm run check:types && npm run check:imports && npm run test -- --run",
    "check:site": "npm run check:seo && npm run check:links && npm run check:images"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "fast-glob": "^3.3.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/js-yaml": "^4.0.9",
    "cheerio": "^1.2.0",
    "js-yaml": "^4.1.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  },
  "private": true
}
